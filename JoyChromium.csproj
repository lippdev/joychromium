<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>JoyChromium.Program</StartupObject>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <UBlockVersion>1.75.0</UBlockVersion>
    <UBlockDir>$(MSBuildProjectDirectory)/Assets/extensions/uBlock0.chromium</UBlockDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;tools/**/*.cs" />
    <Content Include="Assets/**" Exclude="Assets/extensions/**" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- uBlock Origin is fetched from its official release at build time and bundled as an unpacked extension. -->
  <Target Name="FetchUBlock" BeforeTargets="BeforeBuild" Condition="!Exists('$(UBlockDir)/manifest.json')">
    <DownloadFile SourceUrl="https://github.com/gorhill/uBlock/releases/download/$(UBlockVersion)/uBlock0_$(UBlockVersion).chromium.zip"
                  DestinationFolder="$(BaseIntermediateOutputPath)" DestinationFileName="ublock.zip" />
    <Unzip SourceFiles="$(BaseIntermediateOutputPath)ublock.zip" DestinationFolder="$(MSBuildProjectDirectory)/Assets/extensions" />
  </Target>
  <Target Name="BundleExtensions" AfterTargets="FetchUBlock" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Include="Assets/extensions/**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
