<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure, WebView2-free sources under test are linked in directly; the shell project itself is WPF-only. -->
    <Compile Include="../../TvIdentity.cs" Link="src/TvIdentity.cs" />
    <Compile Include="../../Theme.cs" Link="src/Theme.cs" />
    <Compile Include="../../Settings.cs" Link="src/Settings.cs" />
    <Compile Include="../../SecurityPolicy.cs" Link="src/SecurityPolicy.cs" />
    <Compile Include="../../Policy.cs" Link="src/Policy.cs" />
    <Compile Include="../../History.cs" Link="src/History.cs" />
    <Compile Include="../../Suggestion.cs" Link="src/Suggestion.cs" />
    <Compile Include="../../ControllerInput.cs" Link="src/ControllerInput.cs" />
    <Compile Include="../../Log.cs" Link="src/Log.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../policy/policy.json" Link="policy.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../policy/policy.json.sig" Link="policy.json.sig" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
