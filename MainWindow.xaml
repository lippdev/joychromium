<Window x:Class="JoyChromium.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JoyChromium"
        Title="JoyChromium" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        Background="#0C0E13" Foreground="#F3F5F9" Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#20242D" />
            <Setter Property="Foreground" Value="#F3F5F9" />
            <Setter Property="BorderBrush" Value="#343A46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#303744" />
                    <Setter Property="BorderBrush" Value="#64DDB5" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#64DDB5" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D0DB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A303C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="#C9D0DB" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8,8,0,0" Margin="0,6,0,0" Padding="12,0,4,0"
                                Width="220" Height="36" BorderBrush="Transparent" BorderThickness="1,1,1,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#20242D" />
                                <Setter Property="Foreground" Value="#F3F5F9" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262B35" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#64DDB5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAB2C0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3B4351" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Background" Value="#272C36" />
            <Setter Property="Foreground" Value="#F3F5F9" />
            <Setter Property="BorderBrush" Value="#3B4351" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#176C57" />
                    <Setter Property="BorderBrush" Value="#64DDB5" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#343C4B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Title bar: tab strip + window controls -->
            <Grid Grid.Row="0" Background="#14171E">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="#64DDB5" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="J" Foreground="#07120F" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:BrowserTab}">
                                <Button Style="{StaticResource TabButton}" Click="Tab_Click" Tag="{Binding}" ToolTip="{Binding Url}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Content="&#xE8BB;" Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource CaptionButton}" Width="34" Height="34" Margin="2,0,0,2" VerticalAlignment="Bottom" Focusable="True"
                            FontSize="11" Content="&#xE710;" ToolTip="New tab · Start" Click="NewTab_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="1" Background="#20242D" BorderBrush="#282D37" BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Content="‹" ToolTip="Back · LB / B" Click="Back_Click" />
                    <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="›" ToolTip="Forward · RB" Click="Forward_Click" />
                    <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="⟳" ToolTip="Reload · X" Click="Reload_Click" />
                    <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Content="⌂" ToolTip="YouTube TV · Home" Click="Home_Click" />
                    <TextBox Grid.Column="4" x:Name="AddressBox" Height="36" Margin="8,0,6,0" Padding="14,0"
                             VerticalContentAlignment="Center" FontSize="14" Foreground="#F3F5F9" Background="#0D1016"
                             BorderBrush="#343A46" BorderThickness="1" CaretBrush="#64DDB5"
                             SelectionBrush="#176C57" ToolTip="URL or search · Y opens controller keyboard"
                             KeyDown="AddressBox_KeyDown" />
                    <Button Grid.Column="5" Style="{StaticResource ToolbarButton}" Width="64" Content="GO" FontSize="13" FontWeight="Bold"
                            Foreground="#07120F" Background="#64DDB5" BorderBrush="#64DDB5" Click="Go_Click" />
                    <Border Grid.Column="6" Margin="10,0,0,0" Padding="10,5" CornerRadius="8" BorderBrush="#315548" BorderThickness="1" Background="#12231D" VerticalAlignment="Center">
                        <TextBlock Text="TV ON" Foreground="#64DDB5" FontSize="11" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Content: one WebView2 per tab, only the active one visible -->
            <Grid Grid.Row="2" Background="#0C0E13">
                <Grid x:Name="BrowserHost" />
                <Border x:Name="KeyboardPanel" Panel.ZIndex="10" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="24" Padding="18" CornerRadius="16"
                        Background="#F0161A22" BorderBrush="#46505E" BorderThickness="1" MaxWidth="920">
                    <StackPanel>
                        <DockPanel Margin="4,0,4,10">
                            <TextBlock x:Name="KeyboardTitle" Text="CONTROLLER KEYBOARD" Foreground="#64DDB5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="D-PAD MOVE  ·  A SELECT  ·  B CLOSE" Foreground="#AAB2C0" FontSize="10" VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid x:Name="KeyboardKeys" Rows="4" Columns="10" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Style="{StaticResource KeyButton}" Width="90" Content="SHIFT" Click="Shift_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="160" Content="SPACE" Click="Space_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="100" Content="⌫" ToolTip="Backspace" Click="Backspace_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="120" Content="ENTER" Click="Enter_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="100" Content="DONE" Click="Done_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#14171E" BorderBrush="#282D37" BorderThickness="0,1,0,0" Padding="14,0">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="ControllerText" DockPanel.Dock="Left" Text="XINPUT · SEARCHING" Foreground="#AAB2C0" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="STARTING · TV IDENTITY ON" Foreground="#AAB2C0" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="Y KEYBOARD · START NEW TAB · BACK CLOSE TAB · LT/RT SWITCH TAB · LB/RB HISTORY · X RELOAD" Foreground="#778190" FontSize="10" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
