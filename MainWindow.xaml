<Window x:Class="JoyChromium.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JoyChromium"
        Title="JoyChromium" Icon="Assets/app.ico" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8,8,0,0" Margin="0,6,0,0" Padding="12,0,4,0"
                                Width="220" Height="36" BorderBrush="Transparent" BorderThickness="1,1,1,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Title bar: tab strip + window controls -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="J" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:BrowserTab}">
                                <Button Style="{StaticResource TabButton}" Click="Tab_Click" Tag="{Binding}" ToolTip="{Binding Url}" MouseDown="Tab_MouseDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Mute / unmute" Click="MuteTab_Click" />
                                            <MenuItem Header="Duplicate" Click="DuplicateTab_Click" />
                                            <MenuItem Header="Close other tabs" Click="CloseOtherTabs_Click" />
                                            <MenuItem Header="Reopen closed tab" Click="ReopenTab_Click" />
                                            <Separator />
                                            <MenuItem Header="Close" Click="CloseTab_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" AutomationProperties.Name="Close tab" Style="{StaticResource TabCloseButton}" Content="&#xE8BB;" Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab" />
                                        <Button DockPanel.Dock="Right" Tag="{Binding}" Click="MuteTab_Click" ToolTip="Mute / unmute · Ctrl+M" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabCloseButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Content" Value="&#xE767;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Content" Value="&#xE74F;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Image DockPanel.Dock="Left" Source="{Binding Favicon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource CaptionButton}" Width="34" Height="34" Margin="2,0,0,2" VerticalAlignment="Bottom" Focusable="True"
                            AutomationProperties.Name="New tab" FontSize="11" Content="&#xE710;" ToolTip="New tab · Start" Click="NewTab_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Content="‹" ToolTip="Back · LB / B" Click="Back_Click" />
                    <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="›" ToolTip="Forward · RB" Click="Forward_Click" />
                    <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="⟳" ToolTip="Reload · X" Click="Reload_Click" />
                    <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Content="⌂" ToolTip="YouTube TV · Home" Click="Home_Click" />
                    <TextBox Grid.Column="4" x:Name="AddressBox" Height="36" Margin="8,0,6,0" Padding="14,0"
                             VerticalContentAlignment="Center" FontSize="14" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource InputBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CaretBrush="{DynamicResource AccentBrush}"
                             SelectionBrush="{DynamicResource AccentDimBrush}" ToolTip="URL or search · Y opens controller keyboard"
                             KeyDown="AddressBox_KeyDown" TextChanged="AddressBox_TextChanged" />
                    <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=AddressBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                           Width="{Binding ActualWidth, ElementName=AddressBox}">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,0,10,10" Padding="4">
                            <ListBox x:Name="SuggestionsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                     MaxHeight="280" MouseLeftButtonUp="Suggestion_Click" KeyDown="Suggestions_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Suggestion}">
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                    <Button Grid.Column="5" Style="{StaticResource ToolbarButton}" Width="64" Content="GO" FontSize="13" FontWeight="Bold"
                            Foreground="{DynamicResource AccentTextBrush}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Click="Go_Click" />
                    <Button Grid.Column="6" x:Name="FavoriteButton" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            AutomationProperties.Name="Favorite" Content="&#xE734;" ToolTip="Add to favorites · Ctrl+D · LB+Y" Click="Favorite_Click" />
                    <Border Grid.Column="7" Margin="10,0,0,0" Padding="10,5" CornerRadius="8" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Background="{DynamicResource AccentBgBrush}" VerticalAlignment="Center">
                        <TextBlock Text="TV ON" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <Button Grid.Column="8" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            AutomationProperties.Name="Settings" Content="&#xE713;" ToolTip="Settings · Ctrl+," Click="Settings_Click" />
                </Grid>
            </Border>

            <!-- Content: one WebView2 per tab, only the active one visible -->
            <Grid Grid.Row="2" Background="{DynamicResource BackgroundBrush}">
                <Grid x:Name="BrowserHost" />
                <!-- Virtual cursor overlay (Cursor mode). Hit-testing is off so the real mouse events reach the page. -->
                <Canvas x:Name="CursorLayer" Panel.ZIndex="12" IsHitTestVisible="False" Visibility="Collapsed">
                    <Path x:Name="VirtualCursor" Data="M0,0 L0,22 L6,17 L10,26 L13,25 L9,16 L16,16 Z" Fill="{DynamicResource AccentBrush}" Stroke="#07120F" StrokeThickness="1.5" />
                </Canvas>
                <Border x:Name="FindPanel" Panel.ZIndex="15" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,8" Padding="10" CornerRadius="10"
                        Background="{DynamicResource KeyboardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="260" Height="32" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                 Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource AccentBrush}" KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged" />
                        <Button Style="{StaticResource ToolbarButton}" Width="34" Height="32" Content="▲" FontSize="11" ToolTip="Previous (Shift+Enter)" Click="FindPrev_Click" />
                        <Button Style="{StaticResource ToolbarButton}" Width="34" Height="32" Content="▼" FontSize="11" ToolTip="Next (Enter)" Click="FindNext_Click" />
                        <Button Style="{StaticResource ToolbarButton}" Width="34" Height="32" FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" FontSize="10" ToolTip="Close (Esc)" Click="FindClose_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="PermissionPanel" Panel.ZIndex="20" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="24" Padding="20" CornerRadius="14"
                        Background="{DynamicResource KeyboardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" MaxWidth="760">
                    <StackPanel>
                        <TextBlock Text="PERMISSION REQUEST" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock x:Name="PermissionText" Foreground="{DynamicResource TextBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <Button x:Name="PermissionDeny" Style="{StaticResource KeyButton}" Width="110" Content="DENY" Click="PermissionDeny_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="150" Content="ALWAYS DENY" Click="PermissionDenyAlways_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="110" Content="ALLOW" Click="PermissionAllow_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="150" Content="ALWAYS ALLOW" Click="PermissionAllowAlways_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="KeyboardPanel" Panel.ZIndex="10" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="24" Padding="18" CornerRadius="16"
                        Background="{DynamicResource KeyboardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxWidth="920">
                    <StackPanel>
                        <DockPanel Margin="4,0,4,10">
                            <TextBlock x:Name="KeyboardTitle" Text="CONTROLLER KEYBOARD" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="D-PAD MOVE  ·  A SELECT  ·  B CLOSE" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid x:Name="KeyboardKeys" Rows="4" Columns="10" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Style="{StaticResource KeyButton}" Width="90" Content="SHIFT" Click="Shift_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="160" Content="SPACE" Click="Space_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="100" Content="⌫" ToolTip="Backspace" Click="Backspace_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="120" Content="ENTER" Click="Enter_Click" />
                            <Button Style="{StaticResource KeyButton}" Width="100" Content="DONE" Click="Done_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="StatusBar" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="ControllerText" DockPanel.Dock="Left" Text="XINPUT · SEARCHING" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="AdBlockText" DockPanel.Dock="Left" Margin="16,0,0,0" Text="ADBLOCK …" Foreground="{DynamicResource TextFaintBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="Y KEYBOARD · START NEW TAB · BACK CLOSE TAB · LT/RT SWITCH TAB · LB/RB HISTORY · X RELOAD" Foreground="{DynamicResource TextFaintBrush}" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="STARTING · TV IDENTITY ON" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
