{
  "name": "joychromium",
  "productName": "JoyChromium",
  "version": "1.0.0",
  "description": "Controller-first browser for the TV, built on Electron.",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.18.2",
    "@ghostery/adblocker-electron": "2.18.2",
    "electron-updater": "6.8.9"
  }
}
