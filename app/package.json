{
  "name": "joychromium",
  "productName": "JoyChromium",
  "desktopName": "joychromium.desktop",
  "version": "0.1.0-alpha",
  "description": "Controller-first browser for the TV, built on Electron.",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run && node --test scripts/release-version.node-test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:wayland": "npm run build && node scripts/wayland-smoke.mjs",
    "measure:ua": "node scripts/ua-measure.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "preact": "^11.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-electron": "2.20.1",
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "dev.lipp.joychromium",
    "productName": "JoyChromium",
    "protocols": [
      {
        "name": "JoyChromium",
        "schemes": [
          "joychromium"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "lippdev",
      "repo": "joychromium",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Controller-first browser for the TV",
      "desktop": {
        "entry": {
          "Name": "JoyChromium",
          "Categories": "Network;WebBrowser;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgtk-3-0"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "JoyChromium asks for the camera when a site needs it, for example a video call.",
        "NSMicrophoneUsageDescription": "JoyChromium asks for the microphone when a site needs it, for example a video call."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": "130",
          "y": "220",
          "type": "file"
        },
        {
          "x": "410",
          "y": "220",
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": "130",
          "y": "400",
          "type": "file",
          "path": "build/macos/LEIA-ME.txt"
        },
        {
          "x": "410",
          "y": "400",
          "type": "file",
          "path": "build/macos/install-macos.command"
        }
      ]
    },
    "afterPack": "scripts/after-pack.mjs",
    "rpm": {},
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/",
      "customDir": "v44.9.3+wvcus"
    }
  },
  "author": {
    "name": "lippdev",
    "email": "alyxmedical@gmail.com"
  },
  "homepage": "https://github.com/lippdev/joychromium",
  "overrides": {
    "http-cache-semantics": "^4.3.0"
  }
}
