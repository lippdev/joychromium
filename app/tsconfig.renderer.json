{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/ipc.ts",
    "src/shared/settings.ts",
    "src/shared/pages.ts",
    "src/shared/controllerInput.ts",
    "src/shared/platform.ts",
    "src/shared/security.ts"
  ]
}
